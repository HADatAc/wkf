{# CTT Workflow Editor Twig template #}
{% set scenario_label = editor_context.scenarioLabel|default('') %}
{% set scenario_uri = editor_context.scenarioUri|default('') %}
{% set process_label = editor_context.processLabel|default('') %}
{% set process_uri = editor_context.processUri|default('') %}
{% set back_url = editor_context.backToEditProcessBasedStudyUrl|default('') %}

{% if scenario_label or process_label %}
  <div class="ctt-editor-context-header card mb-3">
    <div class="card-body py-2">
      <h3 class="mb-1">Editing {{ scenario_label ?: 'Scenario' }} / {{ process_label ?: 'Process' }}</h3>
      {% if scenario_uri %}
        <p class="mb-1 small text-muted"><strong>Scenario URI:</strong> {{ scenario_uri }}</p>
      {% endif %}
      {% if process_uri %}
        <p class="mb-0 small text-muted"><strong>Process URI:</strong> {{ process_uri }}</p>
      {% endif %}
    </div>
  </div>
{% endif %}

<div id="ctt-workflow-app" class="ctt-editor-container">
  <div class="ctt-loading-indicator">
    <div class="ctt-loading-content">
      <div class="ajax-progress ajax-progress-throbber">
        <div class="throbber">&nbsp;</div>
      </div>
      <p class="ctt-loading-text">Loading CTT Workflow Editor…</p>
    </div>
  </div>
</div>

{% if back_url %}
  <div class="ctt-editor-back-wrapper mt-3 mb-2">
    <a href="{{ back_url }}" class="btn btn-outline-secondary">Back to Edit Process-Based Study</a>
  </div>
{% endif %}

<script>
  (function () {
    var container = document.getElementById('ctt-workflow-app');
    if (!container || container.getAttribute('data-ctt-inline-timeout-guard') === '1') {
      return;
    }

    container.setAttribute('data-ctt-inline-timeout-guard', '1');
    var requestedTimeout = 10000;
    try {
      if (window.drupalSettings && drupalSettings.ctt && drupalSettings.ctt.connectionTimeoutMs) {
        requestedTimeout = parseInt(drupalSettings.ctt.connectionTimeoutMs, 10);
      }
    }
    catch (e) {
      requestedTimeout = 10000;
    }

    var timeoutMs = (!isNaN(requestedTimeout) && requestedTimeout >= 5000)
      ? requestedTimeout
      : 10000;
    var startedAt = Date.now();
    var resolved = false;
    var timeoutTriggered = false;
    var maxGuardLifetimeMs = 60000;

    function htmlEscape(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function getCombinedText() {
      var containerText = String(container.textContent || '');
      var bodyText = '';
      if (document.body) {
        if (typeof document.body.innerText === 'string' && document.body.innerText.trim() !== '') {
          bodyText = String(document.body.innerText);
        }
        else {
          bodyText = String(document.body.textContent || '');
        }
      }
      return (containerText + ' ' + bodyText).replace(/\s+/g, ' ').trim().toLowerCase();
    }

    function looksStuckConnecting() {
      var text = getCombinedText();
      return text.indexOf('connecting to api') !== -1;
    }

    function looksLoadedSurface() {
      var text = String(container.innerText || container.textContent || '')
        .replace(/\s+/g, ' ')
        .trim()
        .toLowerCase();

      if (text.indexOf('connecting to api') !== -1) {
        return false;
      }

      if (text.indexOf('loading ctt workflow editor') !== -1) {
        return false;
      }

      var nodeCount = container.querySelectorAll ? container.querySelectorAll('*').length : 0;
      if (nodeCount >= 10) {
        return true;
      }

      return text.length >= 80;
    }

    function getOrCreateTimeoutBanner() {
      var banner = document.getElementById('ctt-inline-timeout-banner');
      if (banner) {
        return banner;
      }

      banner = document.createElement('div');
      banner.id = 'ctt-inline-timeout-banner';
      banner.className = 'ctt-api-timeout-wrapper';

      if (container.parentNode) {
        container.parentNode.insertBefore(banner, container);
      }
      else if (document.body) {
        document.body.insertBefore(banner, document.body.firstChild);
      }

      return banner;
    }

    function enforceTimeoutState() {
      if (!timeoutTriggered) {
        return;
      }

      if (container.style.display !== 'none') {
        container.style.display = 'none';
      }
      if (container.getAttribute('aria-hidden') !== 'true') {
        container.setAttribute('aria-hidden', 'true');
      }
    }

    function renderTimeoutFallback() {
      if (timeoutTriggered) {
        enforceTimeoutState();
        return;
      }

      var elapsed = Math.max(1, Math.round((Date.now() - startedAt) / 1000));
      var processUri = '';
      try {
        if (window.drupalSettings && drupalSettings.ctt && drupalSettings.ctt.processUri) {
          processUri = String(drupalSettings.ctt.processUri);
        }
      }
      catch (e) {
        processUri = '';
      }

      var banner = getOrCreateTimeoutBanner();
      banner.innerHTML = ''
        + '<div class="alert alert-warning ctt-api-timeout" role="alert" style="margin:12px;">'
        + '<h4 class="alert-heading" style="margin-top:0;">API connection timeout</h4>'
        + '<p style="margin-bottom:8px;">The editor stayed in Connecting to API for ' + elapsed + 's and was interrupted to avoid an infinite loop.</p>'
        + '<p style="margin-bottom:12px;"><small>Process URI: ' + htmlEscape(processUri || 'n/a') + '</small></p>'
        + '<button type="button" class="btn btn-primary btn-sm" data-ctt-retry-inline="1">Retry connection</button>'
        + '</div>';

      var retry = banner.querySelector('[data-ctt-retry-inline="1"]');
      if (retry) {
        retry.addEventListener('click', function () {
          window.location.reload();
        });
      }

      timeoutTriggered = true;
      enforceTimeoutState();
      resolved = true;
    }

    function evaluate() {
      if (resolved) {
        return;
      }

      var elapsed = Date.now() - startedAt;
      if (elapsed < timeoutMs) {
        return;
      }

      if (looksStuckConnecting()) {
        renderTimeoutFallback();
        return;
      }

      if (looksLoadedSurface()) {
        resolved = true;
        return;
      }

      // Keep checking for a short grace window in case the connecting
      // message is rendered asynchronously after initial timeout.
      if (elapsed >= (timeoutMs + 3000)) {
        renderTimeoutFallback();
      }
    }

    var intervalId = window.setInterval(function () {
      if (resolved) {
        clearInterval(intervalId);
        return;
      }

      if ((Date.now() - startedAt) > maxGuardLifetimeMs) {
        clearInterval(intervalId);
        return;
      }

      evaluate();
      enforceTimeoutState();
    }, 500);

    window.setTimeout(evaluate, timeoutMs + 100);
  })();
</script>

{# Study Metadata Panel - Process-Based Study Integration (Phase 3) #}
<div id="ctt-study-metadata-panel" class="ctt-study-metadata-panel" style="margin-top: 20px; display: none;">
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0">
        <button class="btn btn-link" type="button" data-toggle="collapse" data-target="#studyMetadataCollapse" aria-expanded="false" aria-controls="studyMetadataCollapse">
          <i class="fa fa-flask"></i> Study Metadata (Optional)
        </button>
        <button id="manage-study-properties-btn" class="btn btn-sm btn-secondary float-right" type="button">
          <i class="fa fa-edit"></i> Manage Study Properties
        </button>
      </h5>
    </div>
    
    <div id="studyMetadataCollapse" class="collapse">
      <div class="card-body">
        <p class="text-muted small">
          These fields are optional. If left empty, they will be auto-generated when the workflow is saved.
        </p>
        
        <div class="form-group">
          <label for="ctt-study-title">Study Title</label>
          <input type="text" id="ctt-study-title" class="form-control" placeholder="Defaults to workflow label">
          <small class="form-text text-muted">Full title of the study</small>
        </div>
        
        <div class="form-group">
          <label for="ctt-study-id">Study ID</label>
          <input type="text" id="ctt-study-id" class="form-control" placeholder="Auto-generated (STD-XXX)">
          <small class="form-text text-muted">Must start with "STD-". Leave empty to auto-generate from workflow ID.</small>
        </div>
        
        <div class="form-group">
          <label for="ctt-institution">Institution</label>
          <input type="text" id="ctt-institution" class="form-control" placeholder="Defaults to your organization">
          <small class="form-text text-muted">Institution conducting the study</small>
        </div>
        
        <div class="form-group">
          <label for="ctt-pi">Principal Investigator</label>
          <input type="text" id="ctt-pi" class="form-control" placeholder="Defaults to workflow creator">
          <small class="form-text text-muted">Lead researcher</small>
        </div>
        
        <div class="form-group">
          <label for="ctt-contact-email">Contact Email</label>
          <input type="email" id="ctt-contact-email" class="form-control" placeholder="Defaults to your email">
          <small class="form-text text-muted">Contact email for study inquiries</small>
        </div>
        
        <div class="row">
          <div class="col-md-6">
            <div class="form-group">
              <label for="ctt-start-date">Start Date</label>
              <input type="date" id="ctt-start-date" class="form-control">
            </div>
          </div>
          <div class="col-md-6">
            <div class="form-group">
              <label for="ctt-end-date">End Date</label>
              <input type="date" id="ctt-end-date" class="form-control">
            </div>
          </div>
        </div>
        
        <div class="alert alert-info">
          <i class="fa fa-info-circle"></i> 
          <strong>Advanced Properties:</strong> Click "Manage Study Properties" above to edit specific aims, significance, and other advanced study metadata.
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    // Show study metadata panel after CTT editor loads
    function initStudyMetadataPanel() {
      var panel = document.getElementById('ctt-study-metadata-panel');
      if (panel) {
        panel.style.display = 'block';
      }
      
      // Handle "Manage Study Properties" button
      var manageBtn = document.getElementById('manage-study-properties-btn');
      if (manageBtn) {
        manageBtn.addEventListener('click', function() {
          // Get current workflow/process URI from drupalSettings
          var processUri = '';
          try {
            if (window.drupalSettings && drupalSettings.ctt && drupalSettings.ctt.processUri) {
              processUri = drupalSettings.ctt.processUri;
            }
          } catch (e) {
            console.error('Could not get process URI', e);
          }
          
          // Navigate to study edit form
          if (processUri) {
            // Find study by process URI and redirect to edit form
            window.location.href = '/std/processbasedstudy/edit/byprocess/' + encodeURIComponent(processUri);
          } else {
            alert('No process URI found. Please save the workflow first.');
          }
        });
      }
    }
    
    // Wait for CTT editor to load before showing panel
    var checkInterval = setInterval(function() {
      var container = document.getElementById('ctt-workflow-app');
      if (container && container.querySelector('*').length > 10) {
        clearInterval(checkInterval);
        setTimeout(initStudyMetadataPanel, 1000);
      }
    }, 500);
    
    // Cleanup after 30 seconds
    setTimeout(function() {
      clearInterval(checkInterval);
    }, 30000);
  })();
</script>
